gitignore
# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Environment variables and secrets
.env
.env.*
!.env.example

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code
# Uncomment if you want to ignore VS Code settings
# .vscode/

# Flutter / Dart
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication
app.*.symbols

# Obfuscation
app.*.map.json

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release
